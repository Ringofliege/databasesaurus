# Meta-DB PostgreSQL connection string (external, managed by Coolify)
DATABASE_URL="postgresql://user:password@localhost:5432/dbhelper?schema=public"

# HTTP Basic Auth credentials
BASIC_AUTH_USER=admin
BASIC_AUTH_PASS=changeme

# GitLab SSH Deploy Key (multi-line, optional)
# GIT_SSH_PRIVATE_KEY="-----BEGIN OPENSSH PRIVATE KEY-----
# ...
# -----END OPENSSH PRIVATE KEY-----"

# Redis URL for multi-instance session storage (optional)
# If not set, in-memory session storage is used
# REDIS_URL=redis://localhost:6379
